@model MyAcademy_PortfolioProject.Entities.Education

@{
    ViewData["Title"] = "Yeni Eğitim Ekle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="page-content-area">

    <div class="content-header-row">
        <div>
            <h2>Yeni Eğitim Ekle</h2>
            <p>Portfolyonuza yeni bir eğitim bilgisi ekleyin.</p>
        </div>

        <a asp-area="Admin"
           asp-controller="Education"
           asp-action="EducationList"
           class="btn-pastel-primary">
            ← Eğitim Listesine Dön
        </a>
    </div>

    <div class="data-table-card" style="padding:25px;">

        <form asp-area="Admin"
              asp-controller="Education"
              asp-action="CreateEducation"
              method="post">

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label class="form-label">Okul / Üniversite Adı</label>
                    <input asp-for="SchoolName"
                           class="form-control"
                           placeholder="Örn: Beykent Üniversitesi"
                           required />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Bölüm</label>
                    <input asp-for="Department"
                           class="form-control"
                           placeholder="Örn: Bilgisayar Mühendisliği"
                           required />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Eğitim Derecesi</label>
                    <select asp-for="Degree" class="form-select" required>
                        <option value="">Derece Seçiniz</option>
                        <option value="Lise">Lise</option>
                        <option value="Ön Lisans">Ön Lisans</option>
                        <option value="Lisans">Lisans</option>
                        <option value="Yüksek Lisans">Yüksek Lisans</option>
                        <option value="Doktora">Doktora</option>
                    </select>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Not Ortalaması (GPA)</label>
                    <input asp-for="GPA"
                           type="number"
                           step="0.01"
                           min="0"
                           max="4"
                           class="form-control"
                           placeholder="Örn: 3.39" />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Başlangıç Tarihi</label>
                    <input asp-for="StartDate"
                           type="date"
                           class="form-control"
                           required />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Bitiş Tarihi</label>
                    <input asp-for="EndDate"
                           type="date"
                           class="form-control" />
                    <small class="text-muted">Devam eden eğitimlerde boş bırakabilirsin.</small>
                </div>

                <div class="col-12 mb-3">
                    <label class="form-label">Açıklama</label>
                    <textarea asp-for="Description"
                              class="form-control"
                              rows="4"
                              placeholder="Eğitim hakkında kısa bir açıklama..."></textarea>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Görüntülenme Sırası</label>
                    <input asp-for="DisplayOrder"
                           type="number"
                           class="form-control"
                           value="0" />
                </div>

                <div class="col-md-6 mb-3 d-flex align-items-center">
                    <div class="form-check mt-4">
                        <input asp-for="IsActive"
                               class="form-check-input"
                               type="checkbox"
                               checked />
                        <label asp-for="IsActive" class="form-check-label">
                            Aktif olarak yayınla
                        </label>
                    </div>
                </div>

            </div>

            <hr />

            <div class="d-flex justify-content-end gap-2">
                <a asp-area="Admin"
                   asp-controller="Education"
                   asp-action="EducationList"
                   class="btn btn-light">
                    İptal
                </a>

                <button type="submit" class="btn-pastel-primary">
                    Eğitimi Kaydet
                </button>
            </div>

        </form>

    </div>
</div>
