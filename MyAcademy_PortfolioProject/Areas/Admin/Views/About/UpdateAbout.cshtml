@model About

@{
    ViewData["Title"] = "Hakkımda Bilgisi Güncelle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<main class="page-content-area">
    <div class="content-header-row">
        <div>
            <h1 class="page-title">Hakkımda Bilgisi Güncelle</h1>
            <p class="page-subtitle">Mevcut hakkımda bilgilerini düzenleyin.</p>
        </div>
    </div>

    <div class="data-table-card p-4">
        <form asp-area="Admin" asp-controller="About" asp-action="UpdateAbout" method="post">

            <input type="hidden" asp-for="AboutId" />

            <div class="mb-3">
                <label class="form-label">Başlık</label>
                <input type="text" asp-for="Title" class="form-control" required />
            </div>

            <div class="mb-3">
                <label class="form-label">Alt Açıklama</label>
                <textarea asp-for="SubDescription" class="form-control" rows="3" required></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label">Açıklama</label>
                <textarea asp-for="Details" class="form-control" rows="6" required></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label">Görsel URL</label>
                <input type="text" name="ImageUrl" class="form-control"
                       value="@Model.ImageUrl"
                       placeholder="https://example.com/gorsel.jpg">
            </div>

            <button type="submit" class="btn-pastel-primary">
                <i class="bi bi-save"></i>
                Güncelle
            </button>

            <a href="/Admin/About/AboutList" class="btn btn-secondary">
                Vazgeç
            </a>

        </form>
    </div>
</main>