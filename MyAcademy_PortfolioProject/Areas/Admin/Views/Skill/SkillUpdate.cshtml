@model Skill

@{
    ViewData["Title"] = "Yetenek Düzenle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<main class="page-content-area">

    <div class="content-header-row">
        <div>
            <h1 class="page-title">Yetenek Düzenle</h1>
            <p class="page-subtitle">Mevcut yetenek kategorisini güncelleyin.</p>
        </div>
    </div>

    <div class="data-table-card" style="padding:25px;">

        <form asp-area="Admin"
              asp-controller="Skill"
              asp-action="SkillUpdate"
              method="post">

            <input type="hidden" asp-for="SkillId" />

            <div class="mb-3">
                <label class="form-label">Yetenek Başlığı</label>
                <input asp-for="Title" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">Açıklama</label>
                <textarea asp-for="Description"
                          class="form-control"
                          rows="4"></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label">İkon Sınıfı</label>
                <input asp-for="IconUrl" class="form-control" />
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn-pastel-primary">
                    Güncelle
                </button>

                <a href="/Admin/Skill/SkillList" class="btn btn-secondary">
                    Vazgeç
                </a>
            </div>

        </form>

    </div>

</main>