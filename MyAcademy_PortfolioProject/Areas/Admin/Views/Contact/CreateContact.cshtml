@model Contact

@{
    ViewData["Title"] = "Create Contact";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<main class="page-content-area">

    <div class="content-header-row">
        <div>
            <h1 class="page-title">Yeni İletişim Bilgisi Ekle</h1>
            <p class="page-subtitle">İletişim bilgilerini buradan yönetebilirsiniz.</p>
        </div>
    </div>

    <div class="data-table-card" style="padding:25px;">

        <form asp-area="Admin"
              asp-controller="Contact"
              asp-action="CreateContact"
              method="post">

            <div class="mb-3">
                <label class="form-label">Başlık</label>
                <input asp-for="Title" class="form-control"
                       placeholder="Örn: İletişim Adresi" />
            </div>

            <div class="mb-3">
                <label class="form-label">Açıklama</label>
                <textarea asp-for="Description"
                          class="form-control"
                          rows="4"
                          placeholder="Açıklama giriniz"></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label">E-posta</label>
                <input asp-for="Email" class="form-control"
                       placeholder="ornek@mail.com" />
            </div>

            <div class="mb-3">
                <label class="form-label">Konum</label>
                <input asp-for="Location" class="form-control"
                       placeholder="İstanbul, Türkiye" />
            </div>

            <div class="mb-3">
                <label class="form-label">Telefon</label>
                <input asp-for="PhoneNumber" class="form-control"
                       placeholder="+90 5XX XXX XX XX" />
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn-pastel-primary">
                    Kaydet
                </button>

                <a href="/Admin/Contact/ContactList"
                   class="btn btn-secondary">
                    Vazgeç
                </a>
            </div>

        </form>

    </div>
</main>