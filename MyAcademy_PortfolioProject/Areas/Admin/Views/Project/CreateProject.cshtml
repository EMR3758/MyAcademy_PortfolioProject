@model Project

@{
    ViewData["Title"] = "Yeni Proje Ekle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="page-content-area">

    <div class="content-header-row">
        <div>
            <h2>Yeni Proje Ekle</h2>
            <p>Portfolyona yeni bir proje ekle.</p>
        </div>
    </div>

    <div class="data-table-card" style="padding: 25px;">

        <form asp-area="Admin"
              asp-controller="Project"
              asp-action="CreateProject"
              method="post">

            <div class="row">

                <!-- Proje Başlığı -->
                <div class="col-md-6 mb-3">
                    <label asp-for="Title" class="form-label">
                        Proje Başlığı
                    </label>
                    <input asp-for="Title"
                           class="form-control"
                           placeholder="Örn: OTAĞ Restaurant Management System"
                           required />
                </div>

                <!-- Proje Kategorisi -->
                <div class="col-md-6 mb-3">
                    <label asp-for="ProjectCategoryId" class="form-label">
                        Proje Kategorisi
                    </label>
                    <select asp-for="ProjectCategoryId"
                            asp-items="ViewBag.Categories"
                            class="form-select"
                            required>
                        <option value="">Kategori seçiniz</option>
                    </select>
                </div>

                <!-- Proje Açıklaması -->
                <div class="col-12 mb-3">
                    <label asp-for="Description" class="form-label">
                        Proje Açıklaması
                    </label>
                    <textarea asp-for="Description"
                              class="form-control"
                              rows="4"
                              placeholder="Projenin ne işe yaradığını açıklayın..."
                              required></textarea>
                </div>

                <!-- Proje Görsel URL -->
                <div class="col-12 mb-3">
                    <label asp-for="ImageUrl" class="form-label">
                        Proje Görsel URL
                    </label>
                    <input asp-for="ImageUrl"
                           class="form-control"
                           placeholder="https://example.com/project.png" />
                </div>

                <!-- Kullanılan Teknolojiler -->
                <div class="col-md-6 mb-3">
                    <label asp-for="Technologies" class="form-label">
                        Kullanılan Teknolojiler
                    </label>
                    <input asp-for="Technologies"
                           class="form-control"
                           placeholder="C#, ASP.NET Core, SQL Server" />
                    <small class="text-muted">
                        Teknolojileri virgülle ayırarak yazabilirsin.
                    </small>
                </div>

                <!-- Proje Bağlantısı -->
                <div class="col-md-6 mb-3">
                    <label asp-for="ProjectUrl" class="form-label">
                        Proje Bağlantısı
                    </label>
                    <input asp-for="ProjectUrl"
                           class="form-control"
                           placeholder="https://github.com/..." />
                </div>

                <!-- Proje Durumu -->
                <div class="col-md-6 mb-3">
                    <label asp-for="ProjectStatus" class="form-label">
                        Proje Durumu
                    </label>
                    <select asp-for="ProjectStatus" class="form-select">
                        <option value="">Durum seçiniz</option>
                        <option value="Open Source">Open Source</option>
                        <option value="Production Ready">Production Ready</option>
                    </select>
                </div>

                <!-- Gösterim Sırası -->
                <div class="col-md-6 mb-3">
                    <label asp-for="DisplayOrder" class="form-label">
                        Gösterim Sırası
                    </label>
                    <input asp-for="DisplayOrder"
                           type="number"
                           class="form-control"
                           min="1" />
                </div>

                <!-- Aktiflik Durumu -->
                <div class="col-12 mb-4">
                    <div class="form-check">
                        <input asp-for="IsActive"
                               class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label">
                            Proje aktif olarak yayınlansın
                        </label>
                    </div>
                </div>

            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn-pastel-primary">
                    <i class="fas fa-save"></i> Projeyi Kaydet
                </button>

                <a href="/Admin/Project/ProjectList"
                   class="btn btn-secondary">
                    İptal
                </a>
            </div>

        </form>

    </div>
</div>
