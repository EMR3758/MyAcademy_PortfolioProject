@model MyAcademy_PortfolioProject.Entities.Project

@{
    ViewData["Title"] = "Proje Güncelle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="page-content-area">

    <div class="content-header-row">
        <div>
            <h2>Proje Güncelle</h2>
            <p>Mevcut proje bilgilerini düzenle.</p>
        </div>
    </div>

    <div class="data-table-card" style="padding: 25px;">

        <form asp-area="Admin"
              asp-controller="Project"
              asp-action="UpdateProject"
              method="post">

            <input type="hidden" asp-for="ProjectId" />

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label asp-for="Title" class="form-label">
                        Proje Başlığı
                    </label>
                    <input asp-for="Title"
                           class="form-control"
                           required />
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="ProjectCategoryId" class="form-label">
                        Proje Kategorisi
                    </label>
                    <select asp-for="ProjectCategoryId"
                            asp-items="ViewBag.Categories"
                            class="form-select"
                            required>
                        <option value="">Kategori seçiniz</option>
                    </select>
                </div>

                <div class="col-12 mb-3">
                    <label asp-for="Description" class="form-label">
                        Proje Açıklaması
                    </label>
                    <textarea asp-for="Description"
                              class="form-control"
                              rows="4"
                              required></textarea>
                </div>

                <div class="col-12 mb-3">
                    <label asp-for="ImageUrl" class="form-label">
                        Proje Görsel URL
                    </label>
                    <input asp-for="ImageUrl"
                           class="form-control"
                           placeholder="https://example.com/project.png" />

                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <div class="mt-3">
                            <p class="text-muted">Mevcut Proje Görseli</p>
                            <img src="@Model.ImageUrl"
                                 alt="Proje Görseli"
                                 style="width: 180px; height: 110px; object-fit: cover; border-radius: 6px;" />
                        </div>
                    }
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Technologies" class="form-label">
                        Kullanılan Teknolojiler
                    </label>
                    <input asp-for="Technologies"
                           class="form-control"
                           placeholder="C#, ASP.NET Core, SQL Server" />
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="ProjectUrl" class="form-label">
                        Proje Bağlantısı
                    </label>
                    <input asp-for="ProjectUrl"
                           class="form-control"
                           placeholder="https://github.com/..." />
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="ProjectStatus" class="form-label">
                        Proje Durumu
                    </label>
                    <select asp-for="ProjectStatus" class="form-select">
                        <option value="">Durum seçiniz</option>
                        <option value="Open Source">Open Source</option>
                        <option value="Production Ready">Production Ready</option>
                        <option value="In Development">In Development</option>
                    </select>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="DisplayOrder" class="form-label">
                        Gösterim Sırası
                    </label>
                    <input asp-for="DisplayOrder"
                           type="number"
                           class="form-control"
                           min="1" />
                </div>

                <div class="col-12 mb-4">
                    <div class="form-check">
                        <input asp-for="IsActive"
                               class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label">
                            Proje aktif olarak yayınlansın
                        </label>
                    </div>
                </div>

            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn-pastel-primary">
                    <i class="fas fa-save"></i> Değişiklikleri Kaydet
                </button>

                <a href="/Admin/Project/ProjectList"
                   class="btn btn-secondary">
                    İptal
                </a>
            </div>

        </form>

    </div>
</div>
