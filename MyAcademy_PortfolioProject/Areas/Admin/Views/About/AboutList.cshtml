@model List<About>
@{
    ViewData["Title"] = "About List";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}
<main class="page-content-area">
    <!-- Silme Modalı -->
    <div id="deleteModal" class="delete-modal-overlay">
        <div class="delete-modal">
            <div class="delete-modal-icon">
                <i class="bi bi-trash3"></i>
            </div>

            <h3>Kaydı Silmek İstiyor musunuz?</h3>

            <p>
                Bu hakkımda kaydını silmek üzeresiniz.
                Bu işlem geri alınamaz.
            </p>

            <form asp-area="Admin"
                  asp-controller="About"
                  asp-action="DeleteAbout"
                  method="post">

                <input type="hidden" id="deleteAboutId" name="id" />

                <div class="delete-modal-actions">
                    <button type="button"
                            class="btn-modal-cancel"
                            onclick="closeDeleteModal()">
                        Vazgeç
                    </button>

                    <button type="submit" class="btn-modal-delete">
                        Evet, Sil
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="content-header-row">
        <div>
            <h1 class="page-title">Hakkımda Yönetimi</h1>
            <p class="page-subtitle">
                Portfolyo sitenizde yer alacak hakkımda bilgilerini buradan yönetebilirsiniz.
            </p>
        </div>

        <div class="header-actions">
            <a href="/Admin/About/CreateAbout"
               class="btn-pastel-primary"
               style="padding: 7px 14px; font-size: 0.8rem;">
                <i class="bi bi-plus-lg"></i>
                <span>Yeni Hakkımda Bilgisi Ekle</span>
            </a>
        </div>
    </div>

    <div class="data-table-card">

        <div class="table-filter-bar">
            <div class="filters-left-group">
                <div class="filter-search-box">
                    <i class="bi bi-search"></i>
                    <input type="text"
                           id="tableSearchInput"
                           placeholder="Başlığa göre ara...">
                </div>
            </div>
        </div>

        <div class="table-responsive-wrapper">
            <table class="custom-admin-table">
                <thead>
                    <tr>
                        <th style="width: 60px;">ID</th>
                        <th>Başlık</th>
                        <th>Alt Açıklama</th>
                        <th>Detaylar</th>
                        <th>Görsel</th>
                        <th style="text-align: right;">İşlemler</th>    
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="col-id">#@item.AboutId</td>

                            <td>
                                <span class="exp-title-text">@item.Title</span>
                            </td>

                            <td>@item.SubDescription</td>

                            <td>@item.Details</td>

                            <td>
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl"
                                         alt="Hakkımda Görseli"
                                         style="width:70px; height:70px; object-fit:cover; border-radius:8px;" />
                                }
                                else
                                {
                                    <span>Görsel yok</span>
                                }
                            </td>

                            <td style="text-align: right;">
                                <div class="row-actions-group justify-content-end">

                                    <a href="/Admin/About/UpdateAbout/@item.AboutId"
                                       class="btn-action-icon btn-edit"
                                       title="Güncelle">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>

                                    <button type="button"
                                            class="btn-action-icon btn-delete"
                                            title="Sil"
                                            onclick="openDeleteModal(@item.AboutId)">
                                        <i class="bi bi-trash3"></i>
                                    </button>

                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="table-footer-area">
            <div class="pagination-counter">
                Toplam <strong>@Model.Count</strong> hakkımda kaydı görüntüleniyor.
            </div>
        </div>

    </div>
</main>

<style>
    .delete-modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, 0.65);
        backdrop-filter: blur(4px);
        z-index: 9999;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

        .delete-modal-overlay.active {
            display: flex;
        }

    .delete-modal {
        background: #fff;
        width: 100%;
        max-width: 430px;
        padding: 32px;
        border-radius: 18px;
        text-align: center;
        box-shadow: 0 20px 60px rgba(0,0,0,0.2);
        animation: modalOpen 0.25s ease;
    }

    .delete-modal-icon {
        width: 65px;
        height: 65px;
        margin: 0 auto 20px;
        border-radius: 50%;
        background: #fff0f0;
        color: #dc3545;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
    }

    .delete-modal h3 {
        font-size: 22px;
        margin-bottom: 12px;
    }

    .delete-modal p {
        color: #777;
        margin-bottom: 25px;
    }

    .delete-modal-actions {
        display: flex;
        gap: 12px;
    }

    .btn-modal-cancel,
    .btn-modal-delete {
        flex: 1;
        padding: 12px;
        border: none;
        border-radius: 9px;
        cursor: pointer;
        font-weight: 600;
    }

    .btn-modal-cancel {
        background: #f1f1f1;
        color: #444;
    }

    .btn-modal-delete {
        background: #dc3545;
        color: white;
    }

    @@keyframes modalOpen {
        from {
            opacity: 0;
            transform: translateY(15px) scale(.95);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }
</style>
<script>
    function openDeleteModal(id) {
        document.getElementById("deleteAboutId").value = id;
        document.getElementById("deleteModal").classList.add("active");
    }

    function closeDeleteModal() {
        document.getElementById("deleteModal").classList.remove("active");
    }
</script>