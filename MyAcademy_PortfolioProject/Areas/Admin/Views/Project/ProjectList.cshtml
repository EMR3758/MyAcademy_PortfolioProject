@model List<Project>

@{
    ViewData["Title"] = "Projelerim";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="page-content-area">

    <div class="content-header-row">
        <div>
            <h2>Projelerim</h2>
            <p>Portfolyondaki projeleri yönet.</p>
        </div>

        <a href="/Admin/Project/CreateProject"
           class="btn-pastel-primary">
            <i class="fas fa-plus"></i> Yeni Proje
        </a>
    </div>

    <div class="data-table-card">
        <table class="custom-admin-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Görsel</th>
                    <th>Proje Bilgileri</th>
                    <th>Kategori</th>
                    <th>Teknolojiler</th>
                    <th>Proje Durumu</th>
                    <th>Yayın</th>
                    <th>Sıra</th>
                    <th>İşlemler</th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.ProjectId</td>

                            <td>
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl"
                                         alt="@item.Title"
                                         style="width:75px; height:55px; object-fit:cover; border-radius:5px;" />
                                }
                                else
                                {
                                    <span>Görsel yok</span>
                                }
                            </td>

                            <td>
                                <strong>@item.Title</strong>
                                <div>
                                    <small>
                                        @(item.Description?.Length > 60
                                            ? item.Description.Substring(0, 60) + "..."
                                            : item.Description)
                                    </small>
                                </div>
                            </td>

                            <td>
                                @(item.ProjectCategory?.CategoryName ?? "Kategori yok")
                            </td>

                            <td>@item.Technologies</td>

                            <td>@item.ProjectStatus</td>

                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">Aktif</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Pasif</span>
                                }
                            </td>

                            <td>@item.DisplayOrder</td>

                            <td>
                                <div class="row-actions-group">

                                    <a href="@item.ProjectUrl"
                                       target="_blank"
                                       class="btn-action-icon"
                                       title="Projeyi Görüntüle">
                                        🔗
                                    </a>

                                    <a href="/Admin/Project/UpdateProject/@item.ProjectId"
                                       class="btn-action-icon"
                                       title="Düzenle">
                                        ✏️
                                    </a>

                                    <form method="post"
                                          action="/Admin/Project/DeleteProject/@item.ProjectId"
                                          onsubmit="return confirm('Bu projeyi silmek istediğine emin misin?');">
                                        <button type="submit"
                                                class="btn-action-icon"
                                                title="Sil">
                                            🗑️
                                        </button>
                                    </form>

                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9">Henüz proje eklenmemiş.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>
