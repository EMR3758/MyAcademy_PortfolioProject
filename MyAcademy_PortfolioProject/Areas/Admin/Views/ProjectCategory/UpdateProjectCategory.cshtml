@model ProjectCategory
@{
    ViewData["Title"] = "Proje Kategorisi Güncelle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}
<div class="page-content-area">
    <div class="content-header-row">
        <div>
            <h2>Kategori Güncelle</h2>
            <p>Mevcut proje kategorisini düzenle.</p>
        </div>
    </div>
    <div class="data-table-card" style="padding: 25px;">

        <form asp-area="Admin"
              asp-controller="ProjectCategory"
              asp-action="UpdateProjectCategory"
              method="post">

            <input type="hidden" asp-for="ProjectCategoryId" />

            <div class="mb-3">
                <label class="form-label">Kategori Adı</label>

                <input asp-for="CategoryName"
                       class="form-control"
                       placeholder="Kategori adını giriniz"
                       required />
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn-pastel-primary">
                    <i class="fas fa-save"></i> Değişiklikleri Kaydet
                </button>

                <a href="/Admin/ProjectCategory/ProjectCategoryList"
                   class="btn btn-secondary">
                    İptal
                </a>
            </div>

        </form>

    </div>
</div>