@model List<Education>

@{
    ViewData["Title"] = "Eğitim Bilgilerim";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="page-content-area">
    <div class="content-header-row">
        <div>
            <h2>Eğitim Bilgilerim</h2>
            <p>Portfolyonuzdaki eğitim bilgilerini buradan yönetebilirsiniz.</p>
        </div>

        <a asp-area="Admin"
           asp-controller="Education"
           asp-action="CreateEducation"
           class="btn-pastel-primary">
            + Yeni Eğitim Ekle
        </a>
    </div>

    <div class="data-table-card">
        <div class="table-responsive">
            <table class="custom-admin-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Okul</th>
                        <th>Bölüm</th>
                        <th>Derece</th>
                        <th>Başlangıç</th>
                        <th>Bitiş</th>
                        <th>Durum</th>
                        <th>Sıralama</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.EducationId</td>
                                <td>@item.SchoolName</td>
                                <td>@item.Department</td>
                                <td>@item.Degree</td>
                                <td>@item.StartDate.ToString("dd.MM.yyyy")</td>
                                <td>
                                    @(item.EndDate.HasValue
                                        ? item.EndDate.Value.ToString("dd.MM.yyyy")
                                        : "Devam Ediyor")
                                </td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="status-badge">Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-unread">Pasif</span>
                                    }
                                </td>
                                <td>@item.DisplayOrder</td>
                                <td>
                                    <a asp-area="Admin"
                                       asp-controller="Education"
                                       asp-action="UpdateEducation"
                                       asp-route-id="@item.EducationId"
                                       class="btn btn-sm btn-outline-primary">
                                        Düzenle
                                    </a>

                                    <form asp-area="Admin"
                                          asp-controller="Education"
                                          asp-action="DeleteEducation"
                                          asp-route-id="@item.EducationId"
                                          method="post"
                                          style="display:inline">

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger"
                                                onclick="return confirm('Silmek istediğine emin misin?')">
                                            Sil
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center">
                                Henüz eğitim bilgisi eklenmemiş.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
