@{
    ViewData["Title"] = "Yeni Kayan Yazı Ekle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid px-4 py-4">
    <h2 class="fw-semibold mb-4">Yeni Kayan Yazı Ekle</h2>

    <div class="card border-0 shadow-sm p-4" style="border-radius: 20px;">
        <form method="post">
            <div class="mb-3">
                <label class="form-label">Gösterilecek Yazı</label>
                <input type="text" name="Title" class="form-control"
                       placeholder="Örn: Backend Developer" required />
            </div>

            <div class="mb-3">
                <label class="form-label">Gösterim Sırası</label>
                <input type="number" name="Order" class="form-control"
                       value="1" min="1" required />
            </div>

            <div class="mb-4">
                <label class="form-label">Durum</label>
                <select name="IsActive" class="form-select">
                    <option value="Aktif">Aktif</option>
                    <option value="Pasif">Pasif</option>
                </select>
            </div>

            <button type="submit" class="btn text-white px-4 py-2"
                    style="background-color: #98b7a2;">
                Kaydet
            </button>

            <a href="/Admin/HeroTitle/HeroTitleList"
               class="btn btn-secondary px-4 py-2">
                İptal
            </a>
        </form>
    </div>
</div>
