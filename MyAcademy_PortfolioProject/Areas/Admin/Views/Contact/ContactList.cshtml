@model List<Contact>

@{
    ViewData["Title"] = "İletişim Bilgileri";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<main class="page-content-area">

    <div class="content-header-row">
        <div>
            <h1 class="page-title">İletişim Bilgileri</h1>
            <p class="page-subtitle">İletişim bilgilerinizi buradan yönetebilirsiniz.</p>
        </div>

        <a href="/Admin/Contact/CreateContact" class="btn-pastel-primary">
            <i class="bi bi-plus-lg"></i>
            Yeni İletişim Bilgisi Ekle
        </a>
    </div>

    <div class="data-table-card">

        <div class="table-responsive">
            <table class="custom-admin-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Başlık</th>
                        <th>Açıklama</th>
                        <th>E-posta</th>
                        <th>Telefon</th>
                        <th>Lokasyon</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.ContactId</td>
                            <td>@item.Title</td>
                            <td>@item.Description</td>
                            <td>@item.Email</td>
                            <td>@item.PhoneNumber</td>
                            <td>@item.Location</td>

                            <td>
                                <div class="row-actions-group">

                                    <a href="/Admin/Contact/UpdateContact/@item.ContactId"
                                       class="btn-action-icon btn-edit"
                                       title="Düzenle">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>

                                    <form asp-area="Admin"
                                          asp-controller="Contact"
                                          asp-action="DeleteContact"
                                          method="post">
                                        <input type="hidden" name="id" value="@item.ContactId" />

                                        <button type="submit"
                                                class="btn-action-icon btn-delete"
                                                title="Sil">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </form>

                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="table-footer" style="border-radius: 0; padding: 16px 20px; overflow: visible;">
            Toplam @Model.Count() iletişim kaydı listeleniyor.
        </div>

    </div>

</main>
