@model MyAcademy_PortfolioProject.Entities.HeroSection

@{
    ViewData["Title"] = "Hero Alanını Güncelle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid px-4 py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-semibold mb-2">Ana Sayfa Alanını Düzenle</h1>
            <p class="text-muted mb-0">
                Ana sayfandaki karşılama alanının bilgilerini güncelle.
            </p>
        </div>

        <a href="/Admin/Hero/Hero"
           class="btn btn-outline-secondary px-4">
            Geri Dön
        </a>
    </div>

    <div class="card border-0 shadow-sm"
         style="border-radius: 20px;">

        <div class="card-body p-4">

            <h5 class="fw-semibold mb-4">Hero Bilgileri</h5>

            <form method="post" action="/Admin/Hero/UpdateHero">

                <input type="hidden" name="HeroSectionId"
                       value="@Model.HeroSectionId" />

                <div class="mb-4">
                    <label class="form-label fw-semibold">
                        Karşılama Yazısı
                    </label>
                    <input type="text" name="Greeting"
                           class="form-control"
                           value="@Model.Greeting"
                           placeholder="Merhaba, ben Emirhan" />
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold">
                        Ana Başlık
                    </label>
                    <input type="text" name="Title"
                           class="form-control"
                           value="@Model.Title"
                           placeholder="Ana sayfa başlığın" />
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold">
                        Açıklama
                    </label>
                    <textarea name="Description"
                              class="form-control"
                              rows="4"
                              placeholder="Kendinden bahset...">@Model.Description</textarea>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold">
                        Profil Görseli URL
                    </label>
                    <input type="text" name="MainImageUrl"
                           class="form-control"
                           value="@Model.MainImageUrl"
                           placeholder="https://example.com/profile.jpg" />
                </div>

                @if (!string.IsNullOrEmpty(Model.MainImageUrl))
                {
                    <div class="mb-4">
                        <label class="form-label fw-semibold">
                            Mevcut Profil Görseli
                        </label>
                        <div>
                            <img src="@Model.MainImageUrl"
                                 alt="Profil Görseli"
                                 style="width:150px; height:150px;
                            object-fit:cover; border-radius:15px;" />
                        </div>
                    </div>
                }

                <div class="d-flex justify-content-end gap-2">
                    <a href="/Admin/Hero/Hero"
                       class="btn btn-light border px-4">
                        İptal
                    </a>

                    <button type="submit"
                            class="btn text-white px-4"
                            style="background-color:#98b7a2;">
                        <i class="bi bi-check-lg me-1"></i>
                        Güncelle
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>
