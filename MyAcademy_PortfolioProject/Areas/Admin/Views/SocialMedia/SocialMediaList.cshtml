@model List<MyAcademy_PortfolioProject.Entities.SocialMedia>

@{
    ViewData["Title"] = "Sosyal Medya Hesapları";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-semibold">Sosyal Medya Hesapları</h2>
            <p class="text-muted mb-0">Sosyal medya bağlantılarını yönet.</p>
        </div>

        <a href="/Admin/SocialMedia/CreateSocialMedia" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Yeni Hesap Ekle
        </a>
    </div>

    <div class="card border-0 shadow-sm p-3" style="border-radius: 15px;">
        <div class="table-responsive">

            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Platform</th>
                        <th>Profil</th>
                        <th>Sıra</th>
                        <th>Durum</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <i class="@item.Icon fs-4"></i>
                                    <span class="fw-semibold">@item.Platform</span>
                                </div>
                            </td>

                            <td>
                                <a href="@item.Url" target="_blank"
                                   class="text-decoration-none fw-medium">
                                    Profili Görüntüle
                                    <i class="bi bi-box-arrow-up-right ms-1"></i>
                                </a>
                            </td>

                            <td>@item.Order</td>

                            <td>
                                @if (item.IsActive == "Aktif")
                                {
                                    <span class="badge rounded-pill bg-success-subtle text-success px-3 py-2">
                                        Aktif
                                    </span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill bg-secondary-subtle text-secondary px-3 py-2">
                                        Pasif
                                    </span>
                                }
                            </td>

                            <td class="text-end">
                                <div class="d-inline-flex gap-2">
                                    <a href="/Admin/SocialMedia/UpdateSocialMedia/@item.SocialMediaId"
                                       class="btn btn-sm btn-outline-primary rounded-3">
                                        <i class="bi bi-pencil-square me-1"></i>
                                        Düzenle
                                    </a>

                                    <a href="/Admin/SocialMedia/DeleteSocialMedia/@item.SocialMediaId"
                                       class="btn btn-sm btn-outline-danger rounded-3"
                                       onclick="return confirm('Bu hesabı silmek istediğine emin misin?')">
                                        <i class="bi bi-trash me-1"></i>
                                        Sil
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>
</div>
