@model List<MyAcademy_PortfolioProject.Entities.HeroTitle>

@{
    ViewData["Title"] = "Kayan Yazılar";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid px-4 py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-semibold mb-2">Kayan Yazılar</h1>
            <p class="text-muted mb-0">
                Ana sayfada animasyonlu olarak gösterilen yazıları yönet.
            </p>
        </div>

        <a href="/Admin/HeroTitle/CreateHeroTitle"
           class="btn text-white px-4 py-3"
           style="background-color:#98b7a2; border-radius:12px;">
            <i class="bi bi-plus-lg me-2"></i> Yeni Yazı Ekle
        </a>
    </div>

    <div class="card border-0 shadow-sm" style="border-radius:20px;">
        <div class="card-header bg-transparent py-3 px-4">
            <h5 class="mb-0 fw-semibold">Kayan Yazı Listesi</h5>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">#</th>
                            <th>Yazı</th>
                            <th>Sıra</th>
                            <th>Durum</th>
                            <th class="text-end pe-4">İşlemler</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">@item.HeroTitleId</td>
                                <td class="fw-semibold">@item.Title</td>
                                <td>@item.Order</td>
                                <td>
                                    @if (item.IsActive == "Aktif")
                                    {
                                        <span class="badge bg-success-subtle text-success">
                                            Aktif
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary">
                                            Pasif
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <a href="/Admin/HeroTitle/UpdateHeroTitle/@item.HeroTitleId"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil"></i> Düzenle
                                    </a>

                                    <a href="/Admin/HeroTitle/DeleteHeroTitle/@item.HeroTitleId"
                                       class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i> Sil
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        </div>
    </div>
</div>
