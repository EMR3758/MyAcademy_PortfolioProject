@using MyAcademy_PortfolioProject.Entities
@model Skill

@{
    ViewData["Title"] = "Yeni Yetenek Ekle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<main class="page-content-area">

    <div class="content-header-row">
        <div>
            <h1 class="page-title">Yeni Yetenek Ekle</h1>
            <p class="page-subtitle">
                Yeni bir yetenek kategorisi oluşturabilirsiniz.
            </p>
        </div>
    </div>

    <div class="data-table-card" style="padding:25px;">

        <form asp-area="Admin"
              asp-controller="Skill"
              asp-action="SkillCreate"
              method="post">

            <div class="mb-3">
                <label class="form-label">Yetenek Başlığı</label>
                <input asp-for="Title"
                       class="form-control"
                       placeholder="Örn: C#,JavaScript,Python..." />
            </div>

            <div class="mb-3">
                <label class="form-label">Açıklama</label>
                <textarea asp-for="Description"
                          class="form-control"
                          rows="4"
                          placeholder="Yetenek hakkında açıklama"></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label">İkon URL</label>
                <input asp-for="IconUrl"
                       class="form-control"
                       placeholder="İkon adresini giriniz" />
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn-pastel-primary">
                    Kaydet
                </button>

                <a href="/Admin/Skill/SkillList"
                   class="btn btn-secondary">
                    Vazgeç
                </a>
            </div>

        </form>

    </div>

</main>