@model List<MyAcademy_PortfolioProject.Entities.Project>

<!-- 8. Featured Projects Section -->
<section id="projects">
    <div class="container">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-4 gap-3 reveal-on-scroll">
            <div>
                <div class="eyebrow-badge">
                    <i class="bi bi-folder-check"></i> SEÇİLMİŞ ÇALIŞMALAR
                </div>
                <h2 class="section-title mb-1">
                    Fikirden Ürüne Dönüşen Projeler
                </h2>
                <p class="section-description mb-0">
                    Öğrenme, üretme ve problem çözme süreçlerimin birer yansıması olan projelerimden bazıları.
                </p>
            </div>

            <!-- Filter Buttons -->
            <div class="d-flex flex-wrap gap-2" id="projectFilters">
                <button class="filter-btn active" data-filter="all">Tümü</button>

                @foreach (var category in Model
                    .Where(x => x.ProjectCategory != null)
                    .Select(x => x.ProjectCategory)
                    .GroupBy(x => x.ProjectCategoryId)
                    .Select(x => x.First()))
                {
                    <button class="filter-btn"
                            data-filter="category-@category.ProjectCategoryId">
                        @category.CategoryName
                    </button>
                }
            </div>
        </div>

        <!-- Project Grid -->
        <div class="row g-4" id="projectGrid">

            @foreach (var item in Model)
            {
                <div class="col-lg-6 project-item reveal-on-scroll"
                     data-category="category-@item.ProjectCategoryId">

                    <div class="project-card">

                        <div class="project-thumb-wrap">
                            <img src="@item.ImageUrl"
                                 alt="@item.Title"
                                 class="project-thumb-img">

                            <span class="project-category-tag">
                                @item.ProjectCategory?.CategoryName
                            </span>
                        </div>

                        <div class="project-body">

                            <h3 class="h4 fw-bold mb-2">
                                @item.DisplayOrder. @item.Title
                            </h3>

                            <p class="text-muted small mb-4 flex-grow-1">
                                @item.Description
                            </p>

                            <div class="mb-4">
                                @if (!string.IsNullOrEmpty(item.Technologies))
                                {
                                    foreach (var technology in item.Technologies.Split(','))
                                    {
                                        <span class="tech-badge">
                                            @technology.Trim()
                                        </span>
                                    }
                                }
                            </div>

                            <div class="d-flex align-items-center justify-content-between pt-3 border-top">

                                @if (!string.IsNullOrEmpty(item.ProjectUrl))
                                {
                                    <a href="@item.ProjectUrl"
                                       target="_blank"
                                       class="btn-sage btn-sm">
                                        <span>Projeyi İncele</span>
                                        <i class="bi bi-arrow-up-right"></i>
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted small">
                                        Proje bağlantısı bulunmuyor
                                    </span>
                                }

                                <span class="text-muted small">
                                    <i class="bi bi-git me-1"></i>
                                    @item.ProjectStatus
                                </span>

                            </div>
                        </div>
                    </div>
                </div>
            }

        </div>

        <div class="text-center mt-5">
            <a href="#contact" class="btn-secondary-custom px-4 py-3">
                <span>Tüm Projelerimi Gör</span>
                <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>
</section>
