@model Experience
@{
    ViewData["Title"] = "Deneyimi Güncelle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}
<div class="container">
    <div class="card shadow-sm border-0 bg-transparent">

        <div class="card-header bg-transparent py-3">
            <h4 class="mb-1">Deneyimi Güncelle</h4>
            <small class="text-muted">
                Portfolyonuzdaki iş deneyimini güncelleyin.
            </small>
        </div>
        <div class="card-body p-4">

            <form asp-area="Admin" asp-controller="Experience" asp-action="UpdateExperience" method="post">
                <input type="hidden" asp-for="ExperienceId" />
                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label asp-for="Title" class="form-label">Deneyim Başlığı</label>
                        <input asp-for="Title" class="form-control"
                               placeholder="Örn: Backend Developer" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="CompanyName" class="form-label">Kurum / Şirket</label>
                        <input asp-for="CompanyName" class="form-control"
                               placeholder="Örn: Tech Solutions Inc." />
                    </div>

                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label asp-for="CategoryName" class="form-label">Çalışma Türü</label>
                        <select asp-for="CategoryName" class="form-select">
                            <option value="">Çalışma türü seçiniz</option>
                            <option value="Full-time">Full-time</option>
                            <option value="Part-time">Part-time</option>
                            <option value="Freelance">Freelance</option>
                            <option value="Remote">Remote</option>
                            <option value="Intern">Intern</option>
                        </select>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="DisplayOrder" class="form-label">Görüntülenme Sırası</label>
                        <input asp-for="DisplayOrder" type="number" class="form-control" min="1" />
                    </div>

                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label">Deneyim Açıklaması</label>
                    <textarea asp-for="Description"
                              class="form-control"
                              rows="5"
                              placeholder="Bu deneyimde üstlendiğiniz görevleri, kullandığınız teknolojileri ve başarılarınızı açıklayın..."></textarea>
                    <small class="text-muted">
                        Deneyiminizi ve sorumluluklarınızı detaylı şekilde anlatın.
                    </small>
                </div>
                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label asp-for="StartDate" class="form-label">Başlangıç Tarihi</label>
                        <input asp-for="StartDate" type="date" class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="EndDate" class="form-label">Bitiş Tarihi</label>
                        <input asp-for="EndDate" type="date" class="form-control" />
                    </div>

                </div>
                <div class="row mb-4">

                    <div class="col-md-6">
                        <div class="form-check form-switch">
                            <input asp-for="IsCurrent" class="form-check-input" />
                            <label asp-for="IsCurrent" class="form-check-label">
                                Hâlâ bu kurumda çalışıyorum
                            </label>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" />
                            <label asp-for="IsActive" class="form-check-label">
                                Portfolyoda aktif olarak göster
                            </label>
                        </div>
                    </div>

                </div>
                <div class="d-flex justify-content-end gap-2 border-top pt-3">

                    <a href="/Admin/Experience/ExperienceList" class="btn btn-light"><i class="bi bi-arrow-left"></i> İptal</a>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Deneyimi Kaydet</button>


                </div>
            </form>

        </div>
    </div>
</div>